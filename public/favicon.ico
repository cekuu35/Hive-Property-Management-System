  <!-- Right pillar of H -->
  <rect x="19.5" y="11.5" width="4" height="14" rx="1" fill="#FFFFFF"/>
  
  <!-- Horizontal bar of H -->
  <rect x="12.5" y="17.5" width="7" height="2.5" rx="0.5" fill="#FFFFFF"/>
  
