    {
      "parameters": {
        "path": "mpesa-callback",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "M-Pesa Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "mpesa-callback-webhook"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "merchant_request_id",
              "value": "={{$json.Body.stkCallback.MerchantRequestID}}"
            },
            {
              "name": "checkout_request_id",
              "value": "={{$json.Body.stkCallback.CheckoutRequestID}}"
            },
            {
              "name": "result_code",
              "value": "={{$json.Body.stkCallback.ResultCode}}"
            },
            {
              "name": "result_desc",
              "value": "={{$json.Body.stkCallback.ResultDesc}}"
            },
            {
              "name": "amount",
              "value": "={{$json.Body.stkCallback.CallbackMetadata?.Item?.find(item => item.Name === 'Amount')?.Value}}"
            },
            {
              "name": "mpesa_receipt_number",
              "value": "={{$json.Body.stkCallback.CallbackMetadata?.Item?.find(item => item.Name === 'MpesaReceiptNumber')?.Value}}"
            },
            {
              "name": "transaction_date",
              "value": "={{$json.Body.stkCallback.CallbackMetadata?.Item?.find(item => item.Name === 'TransactionDate')?.Value}}"
            },
            {
              "name": "phone_number",
              "value": "={{$json.Body.stkCallback.CallbackMetadata?.Item?.find(item => item.Name === 'PhoneNumber')?.Value}}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-payment-data",
      "name": "Extract Payment Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
