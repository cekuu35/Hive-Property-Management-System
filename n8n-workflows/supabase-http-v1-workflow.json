        "jsCode": "// Process the response safely\nconst items = $input.all();\n\nconsole.log('Processing response...');\nconsole.log('Number of items:', items.length);\n\nif (!items || items.length === 0) {\n  console.log('No data received');\n  return [];\n}\n\nconst processedItems = items.map(item => {\n  const data = item.json;\n  \n  // Safely extract data with fallbacks\n  return {\n    json: {\n      id: data?.id || 'unknown',\n      status: data?.status || 'unknown',\n      rent_amount: data?.rent_amount || 0,\n      lease_start_date: data?.lease_start_date || 'unknown',\n      tenant_name: data?.tenant_info?.full_name || 'Unknown Tenant',\n      phone: data?.tenant_info?.phone || 'No phone',\n      email: data?.tenant_info?.email || 'No email',\n      property_address: data?.units?.properties?.address || 'Unknown address',\n      unit_number: data?.units?.unit_number || 'Unknown unit',\n      property_name: data?.units?.properties?.name || 'Unknown property'\n    }\n  };\n});\n\nconsole.log(`Processed ${processedItems.length} tenants`);\nreturn processedItems;"
