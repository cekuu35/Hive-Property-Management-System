{
  "name": "Rent Reminder Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1 * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Monthly Rent Reminder",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://kozhlejudselgtmohdfm.supabase.co/rest/v1/tenants?select=*,units(*,properties(*)),tenant_info(*)&status=eq.active",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtvemhsZWp1ZHNlbGd0bW9oZGZtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzQwNDI5OCwiZXhwIjoyMDcyOTgwMjk4fQ.LWosNpPJO_clOXXYa5pqGM36S-FLANk71F8BvcsJf2g"
        },
        "additionalHeaders": {
          "apikey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtvemhsZWp1ZHNlbGd0bW9oZGZtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzQwNDI5OCwiZXhwIjoyMDcyOTgwMjk4fQ.LWosNpPJO_clOXXYa5pqGM36S-FLANk71F8BvcsJf2g",
          "Content-Type": "application/json"
        }
      },
      "id": "get-tenants-due",
      "name": "Get Tenants with Rent Due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "tenant_name",
              "value": "={{$json.tenant_info.full_name}}"
            },
            {
              "name": "property_address",
              "value": "={{$json.units.properties.address}}"
            },
            {
              "name": "rent_amount",
              "value": "={{$json.rent_amount}}"
            },
            {
              "name": "due_date",
              "value": "={{$json.lease_start_date}}"
            },
            {
              "name": "phone_number",
              "value": "={{$json.tenant_info.phone}}"
            },
            {
              "name": "email",
              "value": "={{$json.tenant_info.email}}"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-tenant-data",
      "name": "Prepare Tenant Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtvemhsZWp1ZHNlbGd0bW9oZGZtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzQwNDI5OCwiZXhwIjoyMDcyOTgwMjk4fQ.LWosNpPJO_clOXXYa5pqGM36S-FLANk71F8BvcsJf2g"
        },
        "additionalHeaders": {
          "Content-Type": "application/json"
        },
        "body": {
          "BusinessShortCode": "174379",
          "Password": "{{$node['Generate Password'].json['password']}}",
          "Timestamp": "{{$node['Generate Password'].json['timestamp']}}",
          "TransactionType": "CustomerPayBillOnline",
          "Amount": "={{Math.round($json.rent_amount)}}",
          "PartyA": "={{$json.tenant_info.phone}}",
          "PartyB": "174379",
          "PhoneNumber": "={{$json.tenant_info.phone}}",
          "CallBackURL": "https://your-domain.com/api/mpesa/callback",
          "AccountReference": "RENT-{{$json.id}}",
          "TransactionDesc": "Rent Payment - {{$json.property_address}}"
        }
      },
      "id": "send-stk-push",
      "name": "Send M-Pesa STK Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kozhlejudselgtmohdfm.supabase.co/rest/v1/notifications",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtvemhsZWp1ZHNlbGd0bW9oZGZtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzQwNDI5OCwiZXhwIjoyMDcyOTgwMjk4fQ.LWosNpPJO_clOXXYa5pqGM36S-FLANk71F8BvcsJf2g"
        },
        "additionalHeaders": {
          "apikey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtvemhsZWp1ZHNlbGd0bW9oZGZtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NzQwNDI5OCwiZXhwIjoyMDcyOTgwMjk4fQ.LWosNpPJO_clOXXYa5pqGM36S-FLANk71F8BvcsJf2g",
          "Content-Type": "application/json",
          "Prefer": "return=minimal"
        },
        "body": {
          "tenant_id": "={{$node['Prepare Tenant Data'].json['id']}}",
          "type": "rent_reminder",
          "title": "Rent Payment Reminder",
          "message": "Hello {{$node['Prepare Tenant Data'].json['tenant_name']}}, your rent of KES {{$node['Prepare Tenant Data'].json['rent_amount']}} for {{$node['Prepare Tenant Data'].json['property_address']}} is due on {{$node['Prepare Tenant Data'].json['due_date']}}. Please make payment via M-Pesa.",
          "status": "sent",
          "created_at": "={{$now}}"
        }
      },
      "id": "log-notification",
      "name": "Log Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Monthly Rent Reminder": {
      "main": [
        [
          {
            "node": "Get Tenants with Rent Due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Tenants with Rent Due": {
      "main": [
        [
          {
            "node": "Prepare Tenant Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Tenant Data": {
      "main": [
        [
          {
            "node": "Send M-Pesa STK Push",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send M-Pesa STK Push": {
      "main": [
        [
          {
            "node": "Log Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
